# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables.

# Which data source backs the app. Stage A supports only "sample"
# (JSON fixtures in packages/shared). "supabase" arrives in Stage C.
DATA_SOURCE=sample

# Passcode for the access gate shown before any page. Required.
# Use a long random value for shared deployments.
SITE_PASSCODE=change-me
