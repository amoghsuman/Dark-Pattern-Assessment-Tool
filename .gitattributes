# Enforce LF line endings in the repository and working tree on every platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files are never normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.apk binary
*.ipa binary
*.zip binary
