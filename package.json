{
  "name": "dark-pattern-assessment-tool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @dpat/web dev",
    "build": "pnpm --filter @dpat/web build",
    "start": "pnpm --filter @dpat/web start",
    "lint": "pnpm --filter @dpat/web typegen && eslint . && pnpm lint:words",
    "lint:words": "node scripts/check-avoided-words.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @dpat/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
